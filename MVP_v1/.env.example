# ============================================================
# FaceGuard Backend — Environment configuration
# Copy this file to `.env` and edit values as needed.
# ============================================================

# --- Recognition ---
# Cosine similarity threshold (higher = stricter; with normalized
# 512-dim embeddings, typical range is 0.4–0.6).
THRESHOLD=0.45

# How often (ms) the background recognition loop polls the ML service.
RECOGNITION_INTERVAL_MS=500

# --- Registration ---
# Number of frames to capture when registering a new user.
REGISTRATION_FRAME_COUNT=5
# Delay between consecutive registration frames (ms).
REGISTRATION_FRAME_INTERVAL_MS=400

# --- Database ---
# Path to the SQLite file. Mounted as a Docker volume in production.
DATABASE_PATH=/data/faces.db

# --- ML service ---
# Base URL of the ML service that owns the camera and produces
# annotated MJPEG stream + JSON with embeddings.
ML_SERVICE_URL=http://ml:8001

# --- Admin credentials ---
# A single admin is bootstrapped on first startup. Change the password
# immediately after first login (or pre-hash it with bcrypt and set
# ADMIN_PASSWORD_HASH instead).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-login
# Optional: pre-hashed bcrypt password. If set, takes precedence over
# ADMIN_PASSWORD. Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'pass', bcrypt.gensalt()).decode())"
# ADMIN_PASSWORD_HASH=

# --- Auth ---
# Secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=faceguard_session
# Set to True when behind HTTPS in production.
SESSION_COOKIE_SECURE=False

# --- Servo (US-06 / US-07) ---
# Mode: "gpio" on Raspberry Pi, "emulated" on x86 laptop.
SERVO_MODE=emulated
# BCM pin number for the servo signal wire (only used in gpio mode).
SERVO_PIN=18
# How long (seconds) the servo stays in the "open" position before
# returning to "closed".
SERVO_OPEN_DURATION_SEC=2.0

#LIVENESS
LIVENESS_ENABLED=true
LIVENESS_EAR_THRESHOLD=0.20
LIVENESS_TIMEOUT_SEC=3.0

# --- Server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
