# ============================================================
# FaceGuardV2 — root .env.example
# Copy this file to `.env` and edit values as needed.
#
# Each MVP version has its own .env under its directory:
#   MVP_v0/.env   (legacy prototype — no env vars)
#   MVP_v1/.env   (FastAPI backend — see MVP_v1/.env.example)
# ============================================================

# Shared across versions
DATABASE_PATH=data/local.db

# MVP v1 (FastAPI backend) — full list of variables:
# Copy MVP_v1/.env.example to MVP_v1/.env and edit there.
# Key variables (see MVP_v1/.env.example for full list):
#   THRESHOLD, ML_SERVICE_URL, ADMIN_USERNAME, ADMIN_PASSWORD,
#   SECRET_KEY, SERVO_MODE (gpio|emulated), SERVO_PIN
